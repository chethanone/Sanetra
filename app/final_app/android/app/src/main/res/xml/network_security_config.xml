<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Block all cleartext HTTP traffic across the application. Only verified HTTPS endpoints are permitted. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
